{
  "name": "Pdf Annotator",
  "license": "MIT",
  "version": "1.18.0",
  "author": "AAmoros",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "node scripts/start-local.mjs",
    "start:ia": "node scripts/start-ia.mjs",
    "start:docker": "bash scripts/docker-up.sh",
    "build": "npm run i18n:check && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:pdf-annotator": "node dist/pdf-annotator/server/server.mjs",
    "i18n:check": "node scripts/check-translations.mjs",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI --karma-config=karma.conf.cjs",
    "e2e": "playwright test",
    "release:notes": "node scripts/release-notes.mjs",
    "release:guide": "node scripts/release-guide.mjs",
    "release:deploy": "node scripts/release.mjs",
    "start:desktop": "node scripts/start-desktop.mjs",
    "desktop:pack": "node scripts/sync-desktop-version.mjs && npm run build && cd tools/ai-phase0 && npm install --no-fund --no-audit && cd ../.. && electron-builder --projectDir desktop --publish never",
    "a11y": "node scripts/a11y-audit.mjs --out=a11y-audit.json",
    "a11y:ci": "node scripts/a11y-audit.mjs --out=a11y-audit.json --fail-on=serious",
    "test:helper": "node --test tools/ai-helper/queue.test.mjs tools/ai-helper/server.test.mjs tools/ai-helper/vision-probe.test.mjs",
    "test:desktop": "node --test scripts/merge-mac-feed.test.mjs desktop/update-logic.test.mjs desktop/shell-path.test.mjs desktop/history-nav.test.mjs desktop/trusted-origin.test.mjs desktop/projects.test.mjs desktop/projects-ipc.test.mjs desktop/project-archive.test.mjs desktop/project-sync.test.mjs desktop/sftp-sync.test.mjs desktop/sync-secrets.test.mjs desktop/storage.test.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-server": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@angular/ssr": "^22.2.6",
    "@pdf-lib/fontkit": "1.1.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "express": "^5.1.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.6",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.1",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~7.0.0",
    "@types/node": "^26.0.0",
    "@types/pdfjs-dist": "^2.10.377",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~7.0.2",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "ssh2": "1.17.0",
    "typescript": "~6.0.3"
  }
}
